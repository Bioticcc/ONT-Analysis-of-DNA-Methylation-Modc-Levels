# Project code and tools live on the primary drive.
PROJECT_ROOT=/home/kyle/Desktop/Adam/ONTAnalysis

# Large inputs and all outputs live on the 20 TB drive.
DATA_ROOT=/mnt/20TB_A/Adam/ONTAnalysis
INPUT_ROOT=/mnt/20TB_A/Adam/ONTAnalysis/inputs
OUTPUT_ROOT=/mnt/20TB_A/Adam/ONTAnalysis/outputs

SAMPLE_ID=Pa2_gDNA-2
RUN_ID=20260813_1952_P2I-00660-A_PBO06467_969d9163
RUN_ROOT=/mnt/20TB_A/Adam/ONTAnalysis/Wei_P2a_modSUP/Pa2_gDNA-2/20260813_1952_P2I-00660-A_PBO06467_969d9163
PASS_BAM_DIR=/mnt/20TB_A/Adam/ONTAnalysis/Wei_P2a_modSUP/Pa2_gDNA-2/20260813_1952_P2I-00660-A_PBO06467_969d9163/bam_pass

REFERENCE_NAME=GRCm38p6
REFERENCE_SOURCE=/mnt/20TB_A/Adam/SixBase/DEMO/shared_references/1.0.5_GRCm38p6/duet/duet-ref-1.0.5/reference_genomes/GRCm38p6/GRCm38p6.fa.gz
REFERENCE_DIR=/mnt/20TB_A/Adam/ONTAnalysis/inputs/references/GRCm38p6
REFERENCE_FASTA=/mnt/20TB_A/Adam/ONTAnalysis/inputs/references/GRCm38p6/GRCm38p6.fa
REFERENCE_MMI=/mnt/20TB_A/Adam/ONTAnalysis/inputs/references/GRCm38p6/GRCm38p6.lr-hq.v2.31.mmi

SAMPLE_OUTPUT=/mnt/20TB_A/Adam/ONTAnalysis/outputs/Pa2_gDNA-2
EXPECTED_PASS_BAM_COUNT=74

# Supporting utility. Use the environment binary, not the package-cache binary;
# the latter cannot locate its shared HTSlib on this workstation.
SAMTOOLS_BIN=/home/kyle/miniforge3/envs/bulk_rnaseq_qc/bin/samtools
BGZIP_BIN=/home/kyle/miniforge3/envs/bulk_rnaseq_qc/bin/bgzip
TABIX_BIN=/home/kyle/miniforge3/envs/bulk_rnaseq_qc/bin/tabix
MOSDEPTH_BIN=/home/kyle/Desktop/Adam/ONTAnalysis/bin/mosdepth
MODKIT_BIN=/home/kyle/Desktop/Adam/ONTAnalysis/bin/modkit

# Leave CPU and RAM headroom so the workstation remains responsive.
ALIGNMENT_THREADS=20
SORT_THREADS=12
SORT_MEMORY_PER_THREAD=2G
VALIDATION_THREADS=4

# Stage 03 coverage settings. Mosdepth excludes unmapped, secondary, QC-fail,
# and duplicate reads with flag mask 1796; supplementary alignments remain.
QC_THREADS=12
COVERAGE_WINDOW_SIZE=100000
COVERAGE_THRESHOLDS=1,5,10,20
COVERAGE_EXCLUDE_FLAGS=1796
COVERAGE_MIN_MAPQ=0
LOW_COVERAGE_MIN_1X_BREADTH_PERCENT=80
LOW_COVERAGE_DEPTH_THRESHOLD=5

# Stage 04 methylation settings. CpG dyads are strand-combined, while 5mC and
# 5hmC remain separate. The 10th-percentile filter is Modkit's standard default
# and is made explicit here for auditability.
MODKIT_THREADS=12
MODKIT_IO_THREADS=4
MODKIT_BGZF_THREADS=2
MODKIT_SAMPLING_THREADS=4
MODKIT_TAG_CHECK_READS=50000
MODKIT_SAMPLE_READS=50000
MODKIT_FILTER_PERCENTILE=0.1
# Modkit's standard pileup counters saturate above 65,535 observations. This
# sample contains localized >200,000x alignments, so use its high-depth pileup
# path and retain at most 60,000 observations at any genomic position.
MODKIT_MAX_DEPTH=60000
METHYLATION_WINDOW_SIZE=100000

# Stage 05 single-sample methylation exploration. These are the exact mm10
# annotation assets used by the SixBase workflow, allowing like-for-like
# genomic-feature figures without copying or modifying the source assets.
RSCRIPT_BIN=/home/kyle/miniforge3/envs/bulk_rnaseq_qc/bin/Rscript
METHYLATION_GENCODE_GFF3=/mnt/20TB_A/Adam/SixBase/MAIN_DATA/REFERENCES/mm10/modality_cache/pooch/cc22db7619d207ba2b9d10d45fb3fa5a-gencode.vM25.basic.annotation.gff3.gz
METHYLATION_CPG_ISLANDS_JSON=/mnt/20TB_A/Adam/SixBase/MAIN_DATA/REFERENCES/mm10/modality_cache/pooch/3863cc503ad5bf2a54de354950b9b2ac-track
METHYLATION_CCRE_TABLE=/mnt/20TB_A/Adam/SixBase/MAIN_DATA/REFERENCES/mm10/cCREsENCODE_mouse_mm10_UCSC_2025Jun25.csv
METHYLATION_INTERGENIC_BED=/mnt/20TB_A/Adam/SixBase/MAIN_DATA/REFERENCES/mm10/feature_intergenic.bed
EXPLORATION_MIN_VALID_COVERAGE=10
EXPLORATION_MIN_FEATURE_CPGS=5
EXPLORATION_TOP_WINDOW_COUNT=20
EXPLORATION_PLOT_DPI=300
